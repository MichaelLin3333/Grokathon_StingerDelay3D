# Optional integrations. Export these values in your shell before ./start.sh.
# This file is documentation; the server does not automatically read .env files.
XAI_API_KEY=
XAI_MODEL=grok-4.7
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8765/auth/google/callback
# Or supply a short-lived read-only token instead of setting up OAuth:
GOOGLE_CALENDAR_ACCESS_TOKEN=
